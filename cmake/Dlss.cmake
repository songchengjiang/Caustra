option(CAUSTRA_ENABLE_DLSS "Build optional NVIDIA DLSS Ray Reconstruction" ON)
set(CAUSTRA_DLSS_ROOT "" CACHE PATH "DLSS SDK root containing include/ and lib/")
set(CAUSTRA_DLSS_APPLICATION_ID "0x12345678ABCDEF01ULL" CACHE STRING "NGX application ID (development placeholder by default)")
if(CAUSTRA_ENABLE_DLSS)
  if(NOT CAUSTRA_DLSS_ROOT)
    file(GLOB dlss_roots LIST_DIRECTORIES true
      "${CMAKE_CURRENT_SOURCE_DIR}/../vk_gltf_renderer/build/_deps/DLSSRR-*/DLSS-*")
    list(SORT dlss_roots COMPARE NATURAL ORDER DESCENDING)
    foreach(dlss_root IN LISTS dlss_roots)
      if(EXISTS "${dlss_root}/include/nvsdk_ngx_helpers_dlssd_vk.h")
        set(CAUSTRA_DLSS_ROOT "${dlss_root}" CACHE PATH "DLSS SDK root containing include/ and lib/" FORCE)
        break()
      endif()
    endforeach()
  endif()
  if(NOT EXISTS "${CAUSTRA_DLSS_ROOT}/include/nvsdk_ngx_helpers_dlssd_vk.h")
    message(FATAL_ERROR "DLSS RR SDK not found. Set CAUSTRA_DLSS_ROOT to a DLSS SDK, or use -DCAUSTRA_ENABLE_DLSS=OFF.")
  endif()
  add_library(caustra_ngx STATIC IMPORTED)
  set_target_properties(caustra_ngx PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${CAUSTRA_DLSS_ROOT}/include")
  if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(dlss_platform "Windows_x86_64")
    set_target_properties(caustra_ngx PROPERTIES
      IMPORTED_LOCATION "${CAUSTRA_DLSS_ROOT}/lib/${dlss_platform}/x64/nvsdk_ngx_d.lib"
      IMPORTED_LOCATION_DEBUG "${CAUSTRA_DLSS_ROOT}/lib/${dlss_platform}/x64/nvsdk_ngx_d_dbg.lib")
    set(dlss_runtimes
      "${CAUSTRA_DLSS_ROOT}/lib/${dlss_platform}/rel/nvngx_dlss.dll"
      "${CAUSTRA_DLSS_ROOT}/lib/${dlss_platform}/rel/nvngx_dlssd.dll")
  elseif(UNIX AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
    set(dlss_platform "Linux_x86_64")
    set_target_properties(caustra_ngx PROPERTIES IMPORTED_LOCATION "${CAUSTRA_DLSS_ROOT}/lib/${dlss_platform}/libnvsdk_ngx.a")
    file(GLOB dlss_runtimes "${CAUSTRA_DLSS_ROOT}/lib/${dlss_platform}/rel/libnvidia-ngx-dlss*.so.*")
  else()
    message(FATAL_ERROR "This standalone DLSS build currently supports Windows/Linux x64. Use CAUSTRA_ENABLE_DLSS=OFF on other platforms.")
  endif()
  target_sources(caustra PRIVATE src/dlss_backend.cpp)
  target_link_libraries(caustra PRIVATE caustra_ngx ${CMAKE_DL_LIBS})
  target_compile_definitions(caustra PRIVATE CAUSTRA_HAS_DLSS=1 "CAUSTRA_DLSS_APPLICATION_ID=${CAUSTRA_DLSS_APPLICATION_ID}")
  message(STATUS "DLSS Ray Reconstruction SDK: ${CAUSTRA_DLSS_ROOT}")
endif()

function(caustra_copy_dlss_runtime target)
  if(CAUSTRA_ENABLE_DLSS)
    foreach(runtime IN LISTS dlss_runtimes)
      if(NOT EXISTS "${runtime}")
        message(FATAL_ERROR "DLSS runtime missing: ${runtime}")
      endif()
      add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${runtime}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
    endforeach()
  endif()
endfunction()
